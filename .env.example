# Which LLM answers questions: "openrouter" or "anthropic"
RAG_LLM_PROVIDER=openrouter

# OpenRouter (free key at https://openrouter.ai/keys). Free models end in ":free".
OPENROUTER_API_KEY=
RAG_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Claude (or use `ant auth login` instead)
ANTHROPIC_API_KEY=
RAG_MODEL=claude-opus-5-5

# Retrieval / storage
RAG_DATA_DIR=./data.nosync
RAG_CHUNK_TOKENS=700
RAG_CHUNK_OVERLAP=0.15
RAG_TOP_K=6
